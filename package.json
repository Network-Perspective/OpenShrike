{
  "name": "openshrike",
  "version": "0.4.1",
  "private": true,
  "publisher": "networkperspective",
  "displayName": "OpenShrike",
  "description": "Security-first agentic code reviewer and best-practice auditor built on OpenCode.",
  "license": "MIT",
  "homepage": "https://github.com/Network-Perspective/OpenShrike#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Network-Perspective/OpenShrike.git"
  },
  "bugs": {
    "url": "https://github.com/Network-Perspective/OpenShrike/issues"
  },
  "main": "./dist/vscode/extension.cjs",
  "icon": "docs/openshrike-icon.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "pricing": "Free",
  "qna": "marketplace",
  "type": "module",
  "bin": {
    "shrike": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22",
    "vscode": "^1.101.0"
  },
  "categories": [
    "Linters",
    "Testing",
    "AI",
    "Other"
  ],
  "keywords": [
    "openshrike",
    "code-review",
    "security",
    "code-quality",
    "best-practices",
    "static-analysis",
    "llm",
    "ai",
    "opencode",
    "agent"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openshrike",
          "title": "OpenShrike",
          "icon": "media/openshrike-activity.svg"
        }
      ]
    },
    "views": {
      "openshrike": [
        {
          "id": "openshrike.summary",
          "name": "Summary",
          "type": "webview"
        },
        {
          "id": "openshrike.checks",
          "name": "Checks",
          "contextualTitle": "Checks",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "openshrike.runInitInTerminal",
        "category": "OpenShrike",
        "title": "Run shrike init",
        "icon": "$(terminal)"
      },
      {
        "command": "openshrike.openNodeInstallPage",
        "category": "OpenShrike",
        "title": "Install Node.js",
        "icon": "$(link-external)"
      },
      {
        "command": "openshrike.runScan",
        "category": "OpenShrike",
        "title": "Run Scan",
        "icon": "$(play)"
      },
      {
        "command": "openshrike.runScanWithOverrides",
        "category": "OpenShrike",
        "title": "Run Scan With Overrides",
        "icon": "$(settings-gear)"
      },
      {
        "command": "openshrike.runScanWithScopeOverride",
        "category": "OpenShrike",
        "title": "Change Scope",
        "icon": "$(target)"
      },
      {
        "command": "openshrike.runScanWithRuntimeOverride",
        "category": "OpenShrike",
        "title": "Change Runtime",
        "icon": "$(terminal)"
      },
      {
        "command": "openshrike.cancelScan",
        "category": "OpenShrike",
        "title": "Cancel Scan",
        "icon": "$(debug-stop)"
      },
      {
        "command": "openshrike.loadLastScan",
        "category": "OpenShrike",
        "title": "Load Last Scan",
        "icon": "$(history)"
      },
      {
        "command": "openshrike.openCheckMarkdown",
        "category": "OpenShrike",
        "title": "Open Check Markdown",
        "icon": "$(book)"
      },
      {
        "command": "openshrike.openEvidence",
        "category": "OpenShrike",
        "title": "Open Evidence",
        "icon": "$(link-external)"
      },
      {
        "command": "openshrike.recheckFinding",
        "category": "OpenShrike",
        "title": "Recheck",
        "icon": "$(refresh)"
      },
      {
        "command": "openshrike.fixFinding",
        "category": "OpenShrike",
        "title": "Fix",
        "icon": "$(wrench)"
      },
      {
        "command": "openshrike.editFinding",
        "category": "OpenShrike",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "openshrike.openLastScan",
        "category": "OpenShrike",
        "title": "Open Last Scan Snapshot",
        "icon": "$(preview)"
      },
      {
        "command": "openshrike.showOutput",
        "category": "OpenShrike",
        "title": "Show Output",
        "icon": "$(output)"
      },
      {
        "command": "openshrike.sortChecksById",
        "category": "OpenShrike",
        "title": "Sort Checks By ID",
        "icon": "$(symbol-numeric)"
      },
      {
        "command": "openshrike.sortChecksByStatus",
        "category": "OpenShrike",
        "title": "Sort Checks By Status",
        "icon": "$(warning)"
      },
      {
        "command": "openshrike.sortChecksByName",
        "category": "OpenShrike",
        "title": "Sort Checks By Name",
        "icon": "$(symbol-string)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "openshrike.runScan",
          "when": "view == openshrike.summary",
          "group": "navigation@1"
        },
        {
          "command": "openshrike.loadLastScan",
          "when": "view == openshrike.summary",
          "group": "navigation@2"
        },
        {
          "command": "openshrike.showOutput",
          "when": "view == openshrike.summary",
          "group": "navigation@3"
        },
        {
          "command": "openshrike.sortChecksById",
          "when": "view == openshrike.checks",
          "group": "navigation@1"
        },
        {
          "command": "openshrike.sortChecksByStatus",
          "when": "view == openshrike.checks",
          "group": "navigation@2"
        },
        {
          "command": "openshrike.sortChecksByName",
          "when": "view == openshrike.checks",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "openshrike.editFinding",
          "when": "openshrike.detailEditorActive",
          "group": "navigation@1"
        },
        {
          "command": "openshrike.recheckFinding",
          "when": "openshrike.detailEditorActive",
          "group": "navigation@2"
        },
        {
          "command": "openshrike.fixFinding",
          "when": "openshrike.detailEditorActive",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:extension",
    "build:cli": "tsup --config tsup.cli.config.ts",
    "build:extension": "tsup --config tsup.extension.config.ts",
    "dev": "tsx src/cli.ts",
    "dev:extension": "tsup --config tsup.extension.config.ts --watch",
    "prepare:npm-package": "node scripts/prepare-npm-package.mjs",
    "pack:npm": "npm run build:cli && npm run prepare:npm-package && npm pack .artifacts/npm/package --pack-destination .artifacts/npm",
    "publish:npm": "scripts/publish-npm.sh",
    "publish:vscode": "scripts/publish-vscode.sh",
    "prepare:vscode-runtime": "node scripts/prepare-vscode-runtime-assets.mjs",
    "verify:vscode-runtime": "node scripts/verify-vscode-runtime-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:extension-host": "node tests/extension-host/run.mjs",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:watch": "vitest --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "vscode:prepublish": "npm run build && npm run prepare:vscode-runtime && npm run verify:vscode-runtime",
    "release:prepare": "scripts/create-release.sh"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.3.0",
    "commander": "^14.0.3",
    "ink": "^6.8.0",
    "ink-scroll-view": "^0.3.6",
    "opencode-ai": "^1.3.0",
    "react": "^19.2.0",
    "zod": "^4.1.12"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "vite": "8.0.16",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@lydell/node-pty": "^1.2.0-beta.12",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.2",
    "@types/vscode": "^1.101.0",
    "@vscode/test-electron": "^2.5.2",
    "@xterm/headless": "^6.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2",
    "vitest": "^4.1.9"
  }
}
